<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher's only layout: a transparent host frame that the UiStack fills with
    one screen at a time. Every screen brings its own layout (screen_*.xml); see
    UiStack.kt. Because this window is transparent and carries FLAG_SHOW_WALLPAPER,
    whatever a screen does not paint shows the system wallpaper.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent" />