<?xml version="1.0" encoding="utf-8"?>
<!-- One editable row: a drag handle, the exact home-screen view as a preview, and a
     delete button. Shared by the favorites and widgets editors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/edit_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/move_item"
        android:padding="12dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/icon_tint_muted" />

    <FrameLayout
        android:id="@+id/edit_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/edit_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/remove_item"
        android:padding="12dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/icon_tint_delete" />

</LinearLayout>
