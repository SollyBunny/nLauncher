<?xml version="1.0" encoding="utf-8"?>
<!--
    One editable widget: a drag handle on the left, the exact home-screen widget in
    the middle, and a delete button on the right. The row stays compact so the
    widgets keep their top-left spot.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/move_widget"
        android:padding="12dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/icon_tint_muted" />

    <FrameLayout
        android:id="@+id/widget_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/widget_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/remove_widget"
        android:padding="12dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/icon_tint_delete" />

</LinearLayout>
